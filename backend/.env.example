# Google AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Neo4j AuraDB
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Gmail API (run scripts/gmail_auth.py once to generate gmail_token.json)
GMAIL_SENDER_EMAIL=your-gmail@gmail.com
GMAIL_CREDENTIALS_PATH=gmail_credentials.json   # downloaded from GCP Console
GMAIL_TOKEN_PATH=gmail_token.json               # auto-generated by gmail_auth.py

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Alert recipients (comma-separated; indices are paired — first email with first phone, etc.)
ALERT_RECIPIENTS_EMAIL=ops@yourorg.com,vet@yourorg.com
ALERT_RECIPIENTS_PHONE=+60123456789,+60198765432
